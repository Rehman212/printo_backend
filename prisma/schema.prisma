generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  ADMIN
}

enum OptionUiType {
  SELECT
  CARDS
  NUMBER
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum OrderStatus {
  PROCESSING
  PRINTING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum ProofStatus {
  NONE
  AWAITING
  APPROVED
  CHANGES
}

enum QuoteStatus {
  PENDING
  APPROVED
  DECLINED
}

model User {
  id        String  @id @default(cuid())
  email     String  @unique
  password  String
  name      String
  company   String?
  role      Role    @default(CUSTOMER)

  // Profile settings
  phone       String?
  jobTitle    String?
  website     String?
  industry    String?
  employees   String?
  address     String?
  city        String?
  state       String?
  zip         String?
  country     String?
  timezone    String?
  language    String?
  currency    String?
  avatarUrl   String?

  // Communication preferences
  notifyOrderEmail  Boolean @default(true)
  notifySms         Boolean @default(true)
  notifyWeeklyDigest Boolean @default(true)
  notifyMarketing   Boolean @default(false)

  passwordChangedAt DateTime?

  cartItems      CartItem[]
  orders         Order[]
  quotes         Quote[]
  wishlistItems  WishlistItem[]
  supportTickets SupportTicket[]
  savedDesigns   SavedDesign[]
  productReviews ProductReview[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("users")
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("categories")
}

model Product {
  id               String               @id @default(cuid())
  name             String
  slug             String               @unique
  description      String
  shortDescription String?
  seoTitle         String?
  seoDescription   String?
  basePrice        Float
  compareAt        Float?
  rating           Float                @default(4.5)
  reviews          Int                  @default(0)
  deliveryDays     Int                  @default(3)
  badge            String?
  imageUrl         String?
  galleryUrls      String[]             @default([])
  /** Custom FAQs: [{ question: string, answer: string }] */
  faqs             Json?
  /** Product switcher tabs: [{ id, label, iconUrl?, fields: [{ id, label, type, options?, helpText? }] }] */
  productTabs      Json?
  featured         Boolean              @default(false)
  active           Boolean              @default(true)
  categoryId       String
  category         Category             @relation(fields: [categoryId], references: [id])
  optionGroups     ProductOptionGroup[]
  productReviews   ProductReview[]
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@map("products")
}

model ProductReview {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  rating     Int
  title      String?
  body       String
  authorName String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([productId])
  @@index([userId])
  @@unique([productId, userId])
  @@map("product_reviews")
}

model ProductOptionGroup {
  id        String               @id @default(cuid())
  productId String
  product   Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  key       String
  label     String
  uiType    OptionUiType         @default(SELECT)
  required  Boolean              @default(true)
  sortOrder Int                  @default(0)
  helpText  String?
  values    ProductOptionValue[]
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  @@unique([productId, key])
  @@map("product_option_groups")
}

model ProductOptionValue {
  id        String             @id @default(cuid())
  groupId   String
  group     ProductOptionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  label     String
  value     String
  priceMod  Float              @default(1)
  sortOrder Int                @default(0)
  meta      Json?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@unique([groupId, value])
  @@map("product_option_values")
}

/** CRM / CMS: navigation menus */
model Menu {
  id        String     @id @default(cuid())
  name      String
  location  String     @default("header")
  active    Boolean    @default(true)
  items     MenuItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@map("menus")
}

model MenuItem {
  id        String   @id @default(cuid())
  menuId    String
  menu      Menu     @relation(fields: [menuId], references: [id], onDelete: Cascade)
  label     String
  href      String
  sortOrder Int      @default(0)
  parentId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("menu_items")
}

/** CRM / CMS: blog / news posts */
model Post {
  id          String        @id @default(cuid())
  title       String
  slug        String        @unique
  excerpt     String?
  content     String
  coverImage  String?
  status      ContentStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@map("posts")
}

/** CRM / CMS: static pages */
model Page {
  id             String        @id @default(cuid())
  title          String
  slug           String        @unique
  content        String
  seoTitle       String?
  seoDescription String?
  status         ContentStatus @default(DRAFT)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@map("pages")
}

/** Shopping cart line items (per authenticated user) */
model CartItem {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId  String?
  productSlug String?
  name       String
  image      String   @default("default")
  imageUrl   String?
  quantity   Int      @default(1)
  unitPrice  Float
  size       String   @default("")
  material   String   @default("")
  finishing  String   @default("")
  options    Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
  @@map("cart_items")
}

model Order {
  id               String      @id @default(cuid())
  orderNumber      String      @unique
  userId           String
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  status           OrderStatus @default(PROCESSING)
  subtotal         Float
  shipping         Float       @default(0)
  tax              Float       @default(0)
  discount         Float       @default(0)
  total            Float
  notes            String?
  shippingName     String?
  shippingEmail    String?
  shippingAddress  String?
  shippingCity     String?
  shippingState    String?
  shippingZip      String?
  shippingMethod   String?
  paymentMethod    String?
  artworkFile      String?
  proofStatus      ProofStatus @default(NONE)
  items            OrderItem[]
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([userId])
  @@index([status])
  @@index([proofStatus])
  @@map("orders")
}

model Quote {
  id            String      @id @default(cuid())
  quoteNumber   String      @unique
  customerName  String
  customerEmail String?
  company       String?
  productName   String
  quantity      Int         @default(1)
  total         Float
  notes         String?
  status        QuoteStatus @default(PENDING)
  userId        String?
  user          User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([status])
  @@index([userId])
  @@map("quotes")
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String?
  productSlug String?
  name        String
  image       String  @default("default")
  imageUrl    String?
  quantity    Int     @default(1)
  unitPrice   Float
  size        String  @default("")
  material    String  @default("")
  finishing   String  @default("")
  options     Json?

  @@index([orderId])
  @@map("order_items")
}

model WishlistItem {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId   String?
  productSlug String
  name        String
  imageUrl    String?
  basePrice   Float?
  createdAt   DateTime @default(now())

  @@unique([userId, productSlug])
  @@index([userId])
  @@map("wishlist_items")
}

enum TicketStatus {
  OPEN
  PENDING
  RESOLVED
  CLOSED
}

model SupportTicket {
  id        String       @id @default(cuid())
  ticketNumber String    @unique
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject   String
  message   String
  status    TicketStatus @default(OPEN)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([userId])
  @@index([status])
  @@map("support_tickets")
}

model SavedDesign {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  productSlug String?
  productName String?
  previewUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("saved_designs")
}

